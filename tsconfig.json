{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "dist",
    "dist-*",
    "node_modules",
    "backend",
    "backend-media-storage",
    "tmp",
    "src/screens/**",
    "src/api/_quarantine/**"
  ]
}
